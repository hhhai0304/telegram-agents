# ---------------------------------------------------------------------------
# telegram-agents configuration.
#
# Copy this file to `config.env` and edit it. `config.env` is git-ignored and
# should stay chmod 600 — it holds a token that is effectively a password to
# this machine.
#
# After editing:
#   systemctl --user restart telegram-agents      (user scope)
#   sudo systemctl restart telegram-agents        (system scope)
#
# Migrating from claude-telegram? Every CLAUDE_TG_* variable is still read as
# a fallback for its TGA_* twin, so an old config.env keeps working.
# ---------------------------------------------------------------------------

# --- Required --------------------------------------------------------------

# Bot token from @BotFather on Telegram.
TG_BOT_TOKEN=

# Comma-separated Telegram chat ids allowed to drive the bot. Anyone not listed
# is rejected. This is the only thing standing between a stranger and your
# shell. Don't know your id? Run ./install.sh, it detects it for you.
TGA_ALLOWED_CHAT_IDS=

# --- Agents ----------------------------------------------------------------

# Which agent CLIs show up in /agent, comma-separated. Empty = all known ones:
#   claude    Claude Code      `claude`     npm i -g @anthropic-ai/claude-code
#   opencode  OpenCode         `opencode`   https://opencode.ai
#   kilo      Kilo CLI         `kilo`       npm i -g @kilocode/cli
#   kiro      Kiro CLI         `kiro-cli`   https://kiro.dev
# Agents that are not installed still show up, marked ✗, and refuse to run.
TGA_AGENTS=

# Agent a brand-new chat starts with. Switch any time with /agent.
TGA_AGENT=claude

# Executable overrides, if a CLI is not on the service's PATH.
#TGA_CLAUDE_BIN=/home/me/.local/bin/claude
#TGA_OPENCODE_BIN=
#TGA_KILO_BIN=
#TGA_KIRO_BIN=

# Default model per agent. Empty = don't pass a model flag, let the CLI decide.
#   claude:   sonnet | opus | haiku | fable
#   opencode: provider/model, e.g. anthropic/claude-sonnet-4-5, openai/gpt-5
#   kilo:     same format as opencode
#   kiro:     whatever `kiro-cli chat --list-models` prints
# Every turn opens with the agent, the model and whether that model bills, so a
# reply is never ambiguous about what just spent money. Ids ending in `:free`
# label themselves; list anything else that is free on YOUR account here, as
# exact ids or prefixes (a Google AI Studio key, for instance, is a free tier).
TGA_FREE_MODELS=

TGA_CLAUDE_MODEL=sonnet
TGA_OPENCODE_MODEL=
TGA_KILO_MODEL=
TGA_KIRO_MODEL=

# Claude Code reasoning effort: low | medium | high | xhigh | max
TGA_CLAUDE_EFFORT=high

# Kiro: named agent profile to run with (`kiro-cli chat --agent`). Empty = default.
TGA_KIRO_AGENT=

# OpenCode / Kilo keep session metadata under ~/.local/share/<name>/storage.
# Only set these if yours live somewhere else (used by /sessions).
#TGA_OPENCODE_DATA_DIR=
#TGA_KILO_DATA_DIR=

# --- Language --------------------------------------------------------------

# UI language for the bot's Telegram messages. Shipped: en, vi. Anything a
# translation leaves out falls back to English. Add one by copying
# strings/en.js to strings/<code>.js and translating the values.
TGA_LANG=en

# --- Session defaults ------------------------------------------------------

# Working directory for new sessions. Empty = $HOME. Change at runtime with /cd
TGA_DEFAULT_CWD=

# Claude Code only — the other agents have no approval hook and always run in
# their own auto-approve mode (opencode/kilo `--auto`, kiro `--trust-all-tools`).
# smart = only asks about dangerous work, as classified by risk.js: deleting or
#         overwriting files, sudo, changing permissions, reading keys and secret
#         files, destructive docker/git, writing to /etc, sending data off the
#         box, unknown tools. Everything else runs straight through.
# ask   = approve every tool call (except TGA_AUTO_ALLOW)
# auto  = never asks, but only read-only tools and harmless bash are allowed
TGA_MODE=smart

# batch = buffer everything the agent says and send it once the turn is done
# live  = send each chunk as it arrives (constant buzzing)
TGA_STREAM=batch

# --- Permissions (Claude Code) --------------------------------------------

# bymode = default. Approval prompts follow TGA_MODE above.
# none   = off the leash. Every mode runs `claude --dangerously-skip-permissions`
#          and the hook allows everything, with no buttons left to tap. The bot
#          can then do anything your user account can: delete files, sudo, read
#          your SSH keys, send data anywhere. Only set this if you mean it.
TGA_GUARD_MODE=bymode

# Tools that run without asking. Only applies to mode=ask.
# Careful: "Read" here lets it read ~/.ssh/id_ed25519 without a prompt.
TGA_AUTO_ALLOW=Read,Glob,Grep,TodoWrite

# Approval buttons expire after this many seconds and DENY (fail closed).
TGA_APPROVE_TIMEOUT_SEC=300

# Internal approval endpoint for the hook, bound to 127.0.0.1 only.
# (18791 is what claude-telegram uses — keep them apart if both run.)
TGA_APPROVE_PORT=18792

# --- Limits ----------------------------------------------------------------

# Kill a job after this many seconds, including time spent waiting for approval.
TGA_TIMEOUT_SEC=1800
